# ==============================================================================
# CARDAP ERP & VITRINE — VARIÁVEIS DE AMBIENTE DE PRODUÇÃO (VPS & VERCEL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS & CACHE (VPS)
# ------------------------------------------------------------------------------
# Conexão direta com o PostgreSQL hospedado na VPS
DATABASE_URL="postgresql://cardap_admin:cardap_secret_password_2026@localhost:5432/cardap_db?schema=public"

# Conexão com o Redis para Pub/Sub e Filas em Tempo Real
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. SEGURANÇA & SESSÕES
# ------------------------------------------------------------------------------
# Chave mestra HMAC-SHA256 para tokens JWT e QR Codes de mesas
JWT_SECRET="cardap-ultra-secure-jwt-key-2026-prod"

# ------------------------------------------------------------------------------
# 3. DOMÍNIOS & URLs (VERCEL & VPS)
# ------------------------------------------------------------------------------
# URL pública da Vitrine B2C (hospedada na Vercel)
PUBLIC_VITRINE_URL="https://usecardap.com.br"

# URL pública do Gestão ERP B2B (hospedado na VPS)
PUBLIC_GESTAO_URL="https://gestao.cardap.app"

# Porta do Gestão ERP no servidor
PORT_GESTAO=3000
PORT_VITRINE=3001

# ------------------------------------------------------------------------------
# 4. ENGINE DE WHATSAPP (WAHA NA VPS)
# ------------------------------------------------------------------------------
WAHA_API_URL="http://localhost:3008"
WAHA_API_KEY="cardap_waha_api_key_2026"
WHATSAPP_HOOK_URL="http://localhost:3000/api/waha/webhook"

# ------------------------------------------------------------------------------
# 5. GATEWAYS DE PAGAMENTO (CONFIGURÁVEIS TAMBÉM VIA ERP)
# ------------------------------------------------------------------------------
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY=""
ASAAS_API_KEY=""
EFI_CLIENT_ID=""
EFI_CLIENT_SECRET=""
PAGARME_API_KEY=""
