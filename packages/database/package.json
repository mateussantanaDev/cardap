{
  "name": "@cardap/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:clean-reset": "npx tsx prisma/reset-clean.ts && npx tsx prisma/seed.ts",
    "db:saas-clean": "npx prisma db push --accept-data-loss && npx tsx prisma/seed-saas-admin.ts",
    "db:reset-admin": "npx tsx prisma/reset-and-seed-admin.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@cardap/core": "*",
    "@prisma/client": "^5.10.0"
  },
  "devDependencies": {
    "prisma": "^5.10.0",
    "tsx": "^4.7.0"
  }
}
